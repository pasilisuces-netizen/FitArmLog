<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitArmLog.ViewModels"
             xmlns:models="clr-namespace:FitArmLog.Models"
             x:Class="FitArmLog.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="Historial">

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="Red" Padding="12,6" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadSessionsCommand}">
            <CollectionView ItemsSource="{Binding Sessions}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
                        <Label Text="Todavía no registraste entrenamientos." FontSize="16" HorizontalTextAlignment="Center" />
                        <Label Text="Entrá a una rutina y tocá 'Iniciar entrenamiento'." FontSize="13" TextColor="Gray" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkoutSession">
                        <Grid Padding="12" Margin="10,6" ColumnDefinitions="*,Auto"
                              BackgroundColor="{AppThemeBinding Light=White, Dark=#1e1e1e}">

                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding RoutineName}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                       FontSize="13" TextColor="Gray" />
                                <Label Text="{Binding TotalSets, StringFormat='{0} series'}" FontSize="13" />
                                <Label Text="{Binding TotalVolume, StringFormat='Volumen total: {0:N0} kg'}" FontSize="13" />
                                <Label Text="{Binding Notes}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="Eliminar" TextColor="White"
                                    BackgroundColor="IndianRed" FontSize="12" Padding="10,4"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteSessionCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>

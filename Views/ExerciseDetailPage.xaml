<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitArmLog.ViewModels"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:Class="FitArmLog.Views.ExerciseDetailPage"
             x:DataType="vm:ExerciseDetailViewModel"
             Title="Detalle del ejercicio">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <ffimageloading:CachedImage
                Source="{Binding Exercise.ImageUrl}"
                HeightRequest="220"
                Aspect="AspectFill"
                DownsampleToViewSize="true" />

            <Label Text="{Binding Exercise.Name}"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Label Text="{Binding Exercise.MuscleGroup}"
                   FontSize="16"
                   TextColor="Gray" />

            <Label Text="{Binding Exercise.Description}"
                   FontSize="14" />

            <Button Text="Volver"
                    Command="{Binding GoBackCommand}"
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:FitArmLog.Views"
       x:Class="FitArmLog.AppShell">

    <TabBar>
        <ShellContent Title="Ejercicios" Icon="dumbbell.png"
                      ContentTemplate="{DataTemplate views:ExerciseListPage}"
                      Route="ExerciseListPage" />

        <ShellContent Title="Rutinas" Icon="list.png"
                      ContentTemplate="{DataTemplate views:RoutineListPage}"
                      Route="RoutineListPage" />

        <ShellContent Title="Historial" Icon="clock.png"
                      ContentTemplate="{DataTemplate views:HistoryPage}"
                      Route="HistoryPage" />

        <ShellContent Title="Ajustes" Icon="gear.png"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="SettingsPage" />
    </TabBar>

</Shell>
